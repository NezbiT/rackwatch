# =============================================================================
# RackWatch environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# Every variable below is read by app/config.py (Pydantic Settings).
# Prefix RACKWATCH_ also works (see Settings.model_config).
# =============================================================================

# --- App -----------------------------------------------------------------
# Bind address inside the container. Leave 0.0.0.0 for Docker.
RACKWATCH_HOST=0.0.0.0
RACKWATCH_PORT=8080
# development | production  — development enables /docs and verbose logs.
RACKWATCH_ENV=production
# Used to sign the session cookie. Generate: python -c "import secrets; print(secrets.token_hex(32))"
RACKWATCH_SECRET_KEY=change-me-to-a-long-random-string
# Optional dashboard login. Leave both empty to keep the UI open on LAN.
RACKWATCH_AUTH_USER=
RACKWATCH_AUTH_PASSWORD=
# Required for mutating API calls and inbound webhooks (restart, test alert).
RACKWATCH_API_TOKEN=change-me-api-token
# Public URL used in alert links and Grafana iframe src.
RACKWATCH_PUBLIC_URL=http://localhost:8080
# Display name for this node (shown on cards and in HA MQTT discovery).
RACKWATCH_INSTANCE_NAME=homelab

# --- Metrics scrape ------------------------------------------------------
# How often the collector loop pushes a snapshot over WebSocket (seconds).
RACKWATCH_REFRESH_SECONDS=3
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
# URL the *browser* uses to load Grafana iframes (host-reachable, not docker DNS).
GRAFANA_PUBLIC_URL=http://localhost:3001
# Grafana dashboard UID provisioned in grafana/provisioning/dashboards/json/
GRAFANA_DASHBOARD_UID=rackwatch-overview
# Optional Glances REST API (for swap, network, disk I/O, processes, sensors)
GLANCES_URL=

# --- Thresholds (percent). Override later from Settings UI. --------------
THRESHOLD_CPU_WARN=85
THRESHOLD_CPU_CRIT=95
THRESHOLD_RAM_WARN=85
THRESHOLD_RAM_CRIT=95
THRESHOLD_DISK_WARN=80
THRESHOLD_DISK_CRIT=90

# --- Auto-restart --------------------------------------------------------
# Flip to false to only detect failures (manual restart still works).
AUTO_RESTART_ENABLED=true
# Seconds to wait after a crash before the first restart attempt.
AUTO_RESTART_DELAY_SECONDS=8
# Ignore further restarts of the same container inside this window.
AUTO_RESTART_COOLDOWN_SECONDS=120
# Hard cap per container per rolling hour (loop protection).
AUTO_RESTART_MAX_PER_HOUR=3
# Comma-separated container name prefixes that must NEVER be restarted
# (RackWatch itself, Prometheus, Grafana, CasaOS core, etc.).
AUTO_RESTART_DENYLIST=rackwatch,prometheus,grafana,casaos,cadvisor,node-exporter
# Empty = all other containers are eligible. Non-empty = allow-list only.
AUTO_RESTART_ALLOWLIST=

# --- Docker --------------------------------------------------------------
# unix:///var/run/docker.sock inside Compose. tcp://host:2375 only on trusted LAN.
DOCKER_HOST=unix:///var/run/docker.sock

# --- Alerts: Telegram ----------------------------------------------------
# Create a bot with @BotFather, then start a chat and get the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alerts: WhatsApp ----------------------------------------------------
# Homelab-friendly: CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
# Or set WHATSAPP_WEBHOOK_URL to an n8n / Twilio / Meta Cloud API endpoint.
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
WHATSAPP_WEBHOOK_URL=

# --- Alerts: n8n / generic webhook --------------------------------------
# POST JSON (see docs/ALERTS.md) to this URL on every new alert.
N8N_WEBHOOK_URL=
# Chat Trigger production URL (Embedded Chat). Proxied at /api/v1/chat/n8n.
N8N_CHAT_WEBHOOK_URL=
# Optional full header, e.g. Authorization: Bearer xxx
N8N_CHAT_AUTH_HEADER=
GENERIC_WEBHOOK_URL=

# --- AI (OpenAI / compatible) --------------------------------------------
# Prefer putting the LLM key in n8n (Credentials), not here, if the agent
# lives in n8n. Use these only if RackWatch itself calls the model.
# Never commit real keys. Rotate if leaked.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional org / project headers for OpenAI enterprise.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# --- Alert behaviour -----------------------------------------------------
# Do not re-send the same fingerprint inside this window (seconds).
ALERT_COOLDOWN_SECONDS=900
# Minimum severity that leaves the box: info | warning | critical
ALERT_MIN_SEVERITY=warning

# --- Home Assistant: REST ------------------------------------------------
# Example: http://homeassistant.local:8123
HA_URL=
# Long-lived access token (HA → Profile → Security → Long-lived access tokens).
HA_TOKEN=
# Entity ids to pin on the dashboard, comma-separated. Empty = auto-pick sensors.
HA_PINNED_ENTITIES=
# Notify target, e.g. notify.mobile_app_pixel. Empty = notify.notify
HA_NOTIFY_SERVICE=notify.notify

# --- Home Assistant: MQTT ------------------------------------------------
# Leave MQTT_HOST empty to disable the MQTT bridge.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=rackwatch
# Publish Home Assistant MQTT discovery configs on startup.
MQTT_HA_DISCOVERY=true
MQTT_HA_DISCOVERY_PREFIX=homeassistant

# --- Data ----------------------------------------------------------------
# SQLite file (alert history, restart log, settings overrides).
DATABASE_URL=sqlite+aiosqlite:////data/rackwatch.db
